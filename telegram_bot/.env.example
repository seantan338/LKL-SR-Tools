# --- Telegram Bot Configuration ---
# 填写来自 Telegram @BotFather 的 Bot Token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# AI 微服务地址 (FastAPI)
AI_BACKEND_URL=http://127.0.0.1:8000
# 与 AI 后端的 INTERNAL_API_SECRET 相同（调用 /api/parse/file/cv 所需）
INTERNAL_API_SECRET=

# 团队 ID (默认为 default_team)
TELEGRAM_DEFAULT_TEAM=default_team

# 顾问白名单 (可选，支持 Telegram ID 或 @username，逗号分隔；留空则允许所有人测试)
TELEGRAM_ALLOWED_USERS=

# 允许监听的群组 (可选，群组 ID 如 -1003899979396 或群名；留空则允许所有拉入该Bot的群)
TELEGRAM_ALLOWED_CHATS=

# 静默监听模式 (true: 仅后台拦截解析入库，不向群组发送回复；false: 开启回复)
TELEGRAM_SILENT_MODE=true

# 独立长轮询模式 (false: 配合 n8n 或外部 Webhook；true: 单机无 Webhook 独立长轮询)
TELEGRAM_ENABLE_POLLING=false

# Web 前端项目访问地址 (用于生成候选人卡片点击跳转链接)
WEB_APP_BASE_URL=http://localhost:3000


