    {
      "parameters": {
        "jsCode": "// Turns the /api/sheets/import-job-orders response into a short Telegram message (HTML parse mode)\nconst r = $input.first().json;\nconst esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst label = s => ({ open: 'Open', urgent: 'Urgent', closed: 'Closed', paused: 'Paused', filled: 'Filled' }[s] || s || '-');\nconst job = i => `${esc(i.company)} – ${esc(i.position)}`;\nconst updatedItems = r.updatedItems || [];\nconst lines = [];\n\nlines.push(`<b>${r.dryRun ? '🧪 [DRY RUN] ' : ''}✅ Job Order 每日同步完成</b>`);\nlines.push(`共 ${r.created + r.updated + r.unchanged} 个岗位：新建 ${r.created}，有变更 ${r.updated}，无变化 ${r.unchanged}`);\n\nconst createdItems = r.createdItems || [];\nif (createdItems.length) {\n  lines.push('', '🆕 <b>新岗位</b>');\n  createdItems.slice(0, 15).forEach(i => lines.push(`• ${job(i)}`));\n  if (r.created > 15) lines.push(`…另 ${r.created - 15} 个`);\n}\n\nconst statusChanges = updatedItems.filter(u => u.statusChange);\nif (statusChanges.length) {\n  lines.push('', '🔄 <b>状态变化</b>');\n  statusChanges.slice(0, 15).forEach(u => lines.push(`• ${job(u)}: ${label(u.statusChange[0])} → ${label(u.statusChange[1])}`));\n}\n\nconst otherChanges = updatedItems.filter(u => !u.statusChange);\nif (otherChanges.length) {\n  lines.push('', '✏️ <b>内容更新</b>');\n  otherChanges.slice(0, 10).forEach(u => lines.push(`• ${job(u)} (${esc(u.changedFields.join(', '))})`));\n}\nif (r.updated > updatedItems.length) lines.push(`…共 ${r.updated} 个岗位有变更`);\n\nconst orphans = r.orphanItems || [];\nif (orphans.length) {\n  lines.push('', `🗂️ <b>表格里已找不到 ${r.orphans} 个仍在招聘的岗位</b>（行被改名或删除；系统未改动，请确认是否关闭）`);\n  orphans.slice(0, 10).forEach(o => lines.push(`• ${job(o)}`));\n  if (r.orphans > 10) lines.push(`…另 ${r.orphans - 10} 个`);\n}\n\nconst skipped = r.skipped || [];\nif (skipped.length) {\n  const rows = skipped.slice(0, 20).map(s => s.row).join(', ');\n  lines.push('', `⚠️ 跳过 ${skipped.length} 行（缺公司名或职位），请在表格补齐：第 ${rows}${skipped.length > 20 ? '…' : ''} 行`);\n}\n\n// Telegram caps a message at 4096 characters\nreturn [{ json: { text: lines.join('\\n').slice(0, 4000) } }];"
      },
      "id": "4d5e6f7a-0001-4000-8000-000000000006",
      "name": "Build Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1840,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Error output items keep the upstream json and add `error`; a { status: \"error\" } response carries `message`\nconst j = $input.first().json;\nconst esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst raw = j.error ?? (j.status === 'error' ? j.message : undefined) ?? j.detail ?? j;\nconst err = typeof raw === 'string' ? raw : (raw.message || raw.description || JSON.stringify(raw).slice(0, 500));\nconst hints = [\n  [/Credentials not found/i, 'Sync Job Orders 节点还没绑定 Header Auth 凭据（X-API-Key）'],\n  [/401|Unauthorized|未授权/i, 'X-API-Key 与后端 INTERNAL_API_SECRET 不一致'],\n  [/404|Not Found/i, '后端还没部署最新代码（缺少 /api/sheets/import-job-orders）'],\n  [/permission|403/i, '表格没有共享给后端 service account 的 client_email，或 GCP 未启用 Google Sheets API'],\n  [/timeout|ECONNRESET|ETIMEDOUT|Application loading/i, '后端没响应，可能仍在 Render 冷启动，稍后重跑'],\n];\nconst hint = (hints.find(([re]) => re.test(err)) || [])[1];\nreturn [{ json: { text: `<b>❌ Job Order 每日同步失败</b>\\n${esc(err)}${hint ? `\\n👉 ${esc(hint)}` : ''}\\n\\n请查看 n8n 的 Executions 记录或后端日志。`.slice(0, 4000) } }];\n"
      },
