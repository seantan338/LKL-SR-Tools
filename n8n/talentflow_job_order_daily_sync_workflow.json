    {
      "parameters": {
        "jsCode": "// Turns the /api/sheets/import-job-orders response into a short Telegram message\nconst r = $input.first().json;\nconst label = s => ({ open: 'Open', urgent: 'Urgent', closed: 'Closed', paused: 'Paused', filled: 'Filled' }[s] || s || '-');\nconst updatedItems = r.updatedItems || [];\nconst lines = [];\n\nlines.push(`${r.dryRun ? '🧪 [DRY RUN] ' : ''}✅ Job Order 每日同步完成`);\nlines.push(`共 ${r.created + r.updated + r.unchanged} 个岗位：新建 ${r.created}，有变更 ${r.updated}，无变化 ${r.unchanged}`);\n\nconst createdItems = r.createdItems || [];\nif (createdItems.length) {\n  lines.push('', '🆕 新岗位：');\n  createdItems.slice(0, 15).forEach(i => lines.push(`• ${i.company} – ${i.position}`));\n  if (r.created > 15) lines.push(`…另 ${r.created - 15} 个`);\n}\n\nconst statusChanges = updatedItems.filter(u => u.statusChange);\nif (statusChanges.length) {\n  lines.push('', '🔄 状态变化：');\n  statusChanges.slice(0, 15).forEach(u => lines.push(`• ${u.company} – ${u.position}: ${label(u.statusChange[0])} → ${label(u.statusChange[1])}`));\n}\n\nconst otherChanges = updatedItems.filter(u => !u.statusChange);\nif (otherChanges.length) {\n  lines.push('', '✏️ 内容更新：');\n  otherChanges.slice(0, 10).forEach(u => lines.push(`• ${u.company} – ${u.position} (${u.changedFields.join(', ')})`));\n}\nif (r.updated > updatedItems.length) lines.push(`…共 ${r.updated} 个岗位有变更`);\n\nconst orphans = r.orphanItems || [];\nif (orphans.length) {\n  lines.push('', `🗂️ 表格里已找不到 ${r.orphans} 个仍在招聘的岗位（行被改名或删除；系统未改动，请确认是否关闭）：`);\n  orphans.slice(0, 10).forEach(o => lines.push(`• ${o.company} – ${o.position}`));\n  if (r.orphans > 10) lines.push(`…另 ${r.orphans - 10} 个`);\n}\n\nconst skipped = r.skipped || [];\nif (skipped.length) {\n  const rows = skipped.slice(0, 20).map(s => s.row).join(', ');\n  lines.push('', `⚠️ 跳过 ${skipped.length} 行（缺公司名或职位），请在表格补齐：第 ${rows}${skipped.length > 20 ? '…' : ''} 行`);\n}\n\n// Telegram caps a message at 4096 characters\nreturn [{ json: { text: lines.join('\\n').slice(0, 4000) } }];"
      },
      "id": "4d5e6f7a-0001-4000-8000-000000000006",
      "name": "Build Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1220,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Both a { status: \"error\" } response and an HTTP failure (after retries) land here\nconst j = $input.first().json;\nconst err = j.message || (j.error && (j.error.message || j.error.description)) || JSON.stringify(j).slice(0, 500);\nreturn [{ json: { text: `❌ Job Order 每日同步失败\\n${err}\\n\\n请查看 n8n 的 Executions 记录或后端日志。`.slice(0, 4000) } }];"
      },
      "id": "4d5e6f7a-0001-4000-8000-000000000007",
      "name": "Build Failure Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1220,
        480
      ]
    },
    {
