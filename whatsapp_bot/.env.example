# ==============================================================================
# WhatsApp 机器人微服务环境变量配置 (Node.js Baileys)
# ==============================================================================

# 服务监听端口 (默认 8002；若部署两套：8002 为个人号，8003 为公司号)
PORT=8002

# 监听 IP 地址 (本地单机填 127.0.0.1；Docker 容器或生产云主机填 0.0.0.0)
HOST=0.0.0.0

# Python AI 微服务接口地址 (用于智能问答与意图解析)
AI_BACKEND_URL=http://127.0.0.1:8000
# 与 AI 后端的 INTERNAL_API_SECRET 相同（调用 /api/agent/chat 所需）
INTERNAL_API_SECRET=

# Firebase Admin 服务账号配置 (用于实时同步顾问号码白名单及到期提醒监听)
# 方式 1: 指定服务账号 JSON 文件路径 (默认自动查找当前目录或上级 ai_backend 目录)
FIREBASE_SERVICE_ACCOUNT_PATH=../ai_backend/firebase-service-account.json

# 方式 2: 直接注入 JSON 内容字符串 (适合无状态容器云平台，二选一即可)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}
