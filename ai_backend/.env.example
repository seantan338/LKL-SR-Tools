# ==============================================================================
# AI 后端微服务环境变量配置 (FastAPI)
# ==============================================================================

# OpenRouter 大模型 API 密钥 (必填，用于职位生成、简历解析与结构化提取)
# 申请地址: https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 模型路由分级配置 (可使用默认或自行指定 OpenRouter 模型标识)
# 深度推理/复杂任务模型 (复杂订单解析等)
MODEL_HEAVY=anthropic/claude-sonnet-4.5
# 职位生成 (JD) 专用模型 (默认已指定为高效的 Gemini 3.8 Flash)
MODEL_JD=google/gemini-3.8-flash
# 轻量任务模型 (候选人基本信息、面试日程模式解析)
MODEL_LIGHT=google/gemini-2.5-flash
# 简历解析专用模型
MODEL_CV=google/gemini-3.8-flash
# 默认主模型
AI_MODEL_NAME=anthropic/claude-sonnet-4.5

# OpenAI 嵌入向量配置 (用于语义匹配与向量检索，选填)
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# 向量数据库持久化目录 (默认 chroma_data)
# CHROMA_PERSIST_DIR=chroma_data

# Firebase Admin 服务账号配置 (选填，若需后端直接写入云端 Firestore)
# 支持指定服务账号 JSON 文件路径或直接粘贴 JSON 字符串 (二选一)
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Firebase 存储桶名称 (选填，用于通过 Telegram 接收简历附件时自动上传至云端 Storage)
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com

# Google Sheets 集成配置 (选填，用于通过服务账号直接同步在线表格)
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json

# Telegram Bot 集成配置 (选填，若需 FastAPI 后端内置长轮询服务)
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_TEAM=default_team
TELEGRAM_ALLOWED_USERS=
TELEGRAM_ALLOWED_CHATS=
TELEGRAM_SILENT_MODE=true
TELEGRAM_ENABLE_POLLING=false

# Web 前端访问地址 (用于候选人卡片点击跳转链接)
WEB_APP_BASE_URL=http://localhost:3000
