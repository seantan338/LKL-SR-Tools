# ==============================================================================
# AI Backend (FastAPI) 环境变量模板
# ------------------------------------------------------------------------------
# 本地开发：复制为 ai_backend/.env 后填写
# Railway：在服务的 Variables 页逐项添加（不需要 .env 文件）
# 标记说明：[必填] 不填会导致核心功能不可用；[选填] 不填则对应功能关闭或使用默认值
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. Google Gemini API（AI 解析核心）
# ------------------------------------------------------------------------------
# [必填] API 密钥，在 https://aistudio.google.com/apikey 创建
GEMINI_API_KEY=your_gemini_api_key_here

# [选填] 模型 ID（填 Gemini API 模型名，不带 "google/" 前缀）
# Pro：订单解析、WhatsApp AI 助手、候选人 AI 匹配
GEMINI_MODEL_PRO=gemini-3.1-pro-preview
# Flash：JD 生成、候选人 / 面试表格解析、简历解析（含扫描件 vision）
GEMINI_MODEL_FLASH=gemini-3.8-flash

# [选填] Gemini OpenAI 兼容端点，一般不需要修改
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/


# ------------------------------------------------------------------------------
# 2. Firebase Admin（后端读写 Firestore：Sheets 同步、Telegram 入库、AI 助手、向量库同步）
# ------------------------------------------------------------------------------
# [必填] 服务账号凭证，二选一：
#   - Railway / 云端：推荐把整个 JSON 压成一行，粘贴到 FIREBASE_SERVICE_ACCOUNT_JSON
#   - 本地开发：把 JSON 文件放在 ai_backend/ 下，填文件路径
# 获取方式：Firebase Console → 项目设置 → 服务账号 → 生成新的私钥（项目 lap-sr-tools）
# ⚠️ 服务账号 JSON 是最高权限凭证，切勿提交到 git
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"lap-sr-tools",...}
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json

# [选填] Firestore 数据库 ID，默认 "(default)"；仅在使用命名数据库时填写
# FIREBASE_DATABASE_ID=(default)

# [选填] Firebase Storage 存储桶，用于保存 Telegram / 入库接口收到的简历附件
# 不填则保存到本地 ai_backend/uploads/（容器重启会丢失）
# 在 Firebase Console → Storage 页面顶部查看，例如 lap-sr-tools.firebasestorage.app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=


# ------------------------------------------------------------------------------
# 3. 向量检索（招聘订单「AI 候选人匹配」）
# ------------------------------------------------------------------------------
# [选填] OpenAI 嵌入向量密钥；不填则自动使用本地 sentence-transformers 模型
#        （首次使用会下载约 80MB 模型，对中文效果较弱）
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# [选填] ChromaDB 持久化目录，默认 ai_backend/chroma_data
# Railway 上建议挂载 Volume 并指向它，否则每次重新部署都要重新「同步向量库」
# CHROMA_PERSIST_DIR=/data/chroma


# ------------------------------------------------------------------------------
# 4. Google Sheets 服务账号（/api/sheets/tabs、/api/sheets/fetch 直接读取表格）
# ------------------------------------------------------------------------------
# [选填] 服务账号 JSON 文件路径；需要先把表格共享给该服务账号的邮箱
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json


# ------------------------------------------------------------------------------
# 5. Telegram Bot（后端内置简历收集机器人）
# ------------------------------------------------------------------------------
# [选填] 在 Telegram 向 @BotFather 发送 /newbot 获取；不填则 Telegram 功能关闭
TELEGRAM_BOT_TOKEN=
# 收到的简历写入哪个团队
TELEGRAM_DEFAULT_TEAM=default_team
# 白名单，逗号分隔：用户填 Telegram username 或数字 ID；群组填数字 chat ID（如 -1001234567890）
# ⚠️ 留空 = 不限制，任何人 / 任何拉机器人进去的群都能上传简历。正式环境务必填写
TELEGRAM_ALLOWED_USERS=
TELEGRAM_ALLOWED_CHATS=
# true = 私聊不回复处理结果（静默入库）
TELEGRAM_SILENT_MODE=true
# true = 后端主动长轮询 Telegram；如果已用 n8n / Webhook 转发消息，保持 false
# ⚠️ 同一个 Bot Token 只能有一个进程在轮询，否则 Telegram 返回 409 Conflict
TELEGRAM_ENABLE_POLLING=false


# ------------------------------------------------------------------------------
# 6. Web 前端地址
# ------------------------------------------------------------------------------
# [选填] 用于 Telegram 回复里的候选人链接，填线上网址（Railway 域名或自定义域名）
WEB_APP_BASE_URL=http://localhost:3000
