rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Membership is stored on users/{uid}.teamId (approval flow), not only teams/*/members.
    function isApprovedOnTeam(teamId) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().teamId == teamId
        && userDoc().role in ['owner', 'manager', 'recruiter'];
    }

    function isOwnerOrManagerOnTeam(teamId) {
      return isApprovedOnTeam(teamId) && userDoc().role in ['owner', 'manager'];
    }

    function isTeamMember(teamId) {
      return isAuthenticated() && exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
    }

    // 考勤打卡仅适用于公司本部 (HQ)；分部 / 合作方团队无需打卡
    function isHqTeam(teamId) {
      return teamId == 'default_team';
    }

    function hasUserDoc() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // 本部 owner / manager：可管理所有用户
    function isHqAdmin() {
      return hasUserDoc() && userDoc().teamId == 'default_team' && userDoc().role in ['owner', 'manager'];
    }

    // 任一团队已批准的 owner / manager
    function isTeamAdmin() {
      return hasUserDoc() && userDoc().teamId != null && userDoc().role in ['owner', 'manager'];
    }

    // Check if current user belongs to a parent team linked to childTeamId
    // (link 文档内容也要核对，避免 "_" 拼接 ID 碰撞)
    function isLinkedParentTeamMember(childTeamId) {
      let linkPath = /databases/$(database)/documents/team_links/$(userDoc().teamId + '_' + childTeamId);
      return hasUserDoc()
        && userDoc().role in ['owner', 'manager', 'recruiter']
        && exists(linkPath)
        && get(linkPath).data.parentTeamId == userDoc().teamId
        && get(linkPath).data.childTeamId == childTeamId;
    }

    // 本人只能修改个人资料字段；role / teamId 只允许重置为待审批 (pending / null)
    function isSelfProfileUpdate(userId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let profileKeys = ['displayName', 'photoURL', 'whatsappNumber', 'waReminderTemplate', 'assignedPic'];
      return isAuthenticated() && request.auth.uid == userId
        && (changed.hasOnly(profileKeys)
          || (changed.hasOnly(profileKeys.concat(['role', 'teamId', 'email', 'uid']))
            && request.resource.data.get('role', 'pending') == 'pending'
            && request.resource.data.get('teamId', null) == null));
    }

    // 分部 owner / manager：只能把待审批或本团队成员设为本团队的 recruiter / manager
    function isSameTeamAdminUpdate() {
      return isTeamAdmin()
        && (resource.data.get('teamId', null) == null || resource.data.get('teamId', null) == userDoc().teamId)
        && resource.data.get('role', 'pending') != 'owner'
        && request.resource.data.get('teamId', null) == userDoc().teamId
        && request.resource.data.get('role', 'pending') in ['recruiter', 'manager'];
    }

    function isSameTeamAdminDelete() {
      return isTeamAdmin()
        && (resource.data.get('teamId', null) == null || resource.data.get('teamId', null) == userDoc().teamId)
        && resource.data.get('role', 'pending') != 'owner';
    }

    match /users/{userId} {
      // 新用户只能以待审批身份建档；初始管理员由人工在 Console 设置
      allow create: if isAuthenticated() && request.auth.uid == userId
        && request.resource.data.get('role', 'pending') == 'pending'
        && request.resource.data.get('teamId', null) == null;
      // Team-wide profile read: PIC names, mutual reminders, approval queue.
      allow read: if isAuthenticated();
      allow update: if isSelfProfileUpdate(userId) || isHqAdmin() || isSameTeamAdminUpdate();
      allow delete: if isHqAdmin() || isSameTeamAdminDelete();
    }

    match /team_links/{linkId} {
      // Members of either parent team or child team can view the link
      allow read: if hasUserDoc()
        && (resource.data.parentTeamId == userDoc().teamId || resource.data.childTeamId == userDoc().teamId);
      // 只有父团队 owner 能为「自己创建的子团队」建立关联；不能关联本部，link ID 必须是 parent_child
      allow create: if hasUserDoc()
        && userDoc().role == 'owner'
        && request.resource.data.parentTeamId == userDoc().teamId
        && linkId == request.resource.data.parentTeamId + '_' + request.resource.data.childTeamId
        && request.resource.data.childTeamId != 'default_team'
        && request.resource.data.childTeamId != request.resource.data.parentTeamId
        && get(/databases/$(database)/documents/teams/$(request.resource.data.childTeamId)).data.parentTeamId == userDoc().teamId;
      allow update: if hasUserDoc()
        && userDoc().role == 'owner'
        && resource.data.parentTeamId == userDoc().teamId
        && request.resource.data.parentTeamId == resource.data.parentTeamId
        && request.resource.data.childTeamId == resource.data.childTeamId;
      allow delete: if hasUserDoc()
        && userDoc().role == 'owner'
        && resource.data.parentTeamId == userDoc().teamId;
    }

    match /teams/{teamId} {
      allow read: if isApprovedOnTeam(teamId) || isTeamMember(teamId) || isLinkedParentTeamMember(teamId);
      allow update: if isOwnerOrManagerOnTeam(teamId);
      // 只有 owner 能创建以自己团队为父团队的新子团队
      allow create: if hasUserDoc()
        && userDoc().role == 'owner'
        && teamId != 'default_team'
        && teamId != userDoc().teamId
        && request.resource.data.parentTeamId == userDoc().teamId;

      match /members/{userId} {
        allow read: if isApprovedOnTeam(teamId) || isTeamMember(teamId) || isLinkedParentTeamMember(teamId);
        // 禁止本人自写 members 文档（否则任何人都能加入任意团队）
        allow write: if isOwnerOrManagerOnTeam(teamId);
      }

      // All approved teammates can see and edit the shared pool (mutual follow-up).
      // Linked parent team members (e.g. HQ) have read-only visibility.
      match /candidates/{candidateId} {
        allow read: if isApprovedOnTeam(teamId) || isTeamMember(teamId) || isLinkedParentTeamMember(teamId);
        allow write: if isApprovedOnTeam(teamId) || isTeamMember(teamId);
      }

      match /job_orders/{orderId} {
        allow read: if isApprovedOnTeam(teamId) || isTeamMember(teamId) || isLinkedParentTeamMember(teamId);
        allow write: if isApprovedOnTeam(teamId) || isTeamMember(teamId);
      }

      match /tags/{tagDoc} {
        allow read: if isApprovedOnTeam(teamId) || isTeamMember(teamId) || isLinkedParentTeamMember(teamId);
        allow write: if isApprovedOnTeam(teamId) || isTeamMember(teamId);
      }

      match /feedback/{feedbackId} {
        allow read: if isApprovedOnTeam(teamId) || isTeamMember(teamId) || isLinkedParentTeamMember(teamId);
        allow create: if (isApprovedOnTeam(teamId) || isTeamMember(teamId))
          && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if isOwnerOrManagerOnTeam(teamId)
          || (isAuthenticated() && resource.data.createdBy == request.auth.uid);
      }

      match /logs/{logId} {
        allow read: if isApprovedOnTeam(teamId) || isTeamMember(teamId) || isLinkedParentTeamMember(teamId);
        // 考勤打卡日志 (targetType == 'ATTENDANCE') 仅限本部写入
        allow create: if (isApprovedOnTeam(teamId) || isTeamMember(teamId))
          && (isHqTeam(teamId) || request.resource.data.get('targetType', '') != 'ATTENDANCE');
        // 不可变审计日志(Immutable Audit Log):
        // - Owner 仅可修改软删除/恢复标记字段
        // - 日志原始内容 (level, action, targetName, details, timestamp, user, module, message)
        //   一经写入即永久不可篡改，杜绝事后掩盖操作痕迹
        // - 绝对禁止物理硬删除
        allow update: if isApprovedOnTeam(teamId)
          && userDoc().role == 'owner'
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['isDeleted', 'deletedAt', 'deletedBy', 'deletedByName',
                        'restoredAt', 'restoredBy', 'restoredByName']);
        allow delete: if false;
      }

      match /ad_versions/{versionId} {
        allow read, write: if isApprovedOnTeam(teamId) || isTeamMember(teamId) || isLinkedParentTeamMember(teamId);
      }

      match /attendance/{attendanceId} {
        allow read: if isApprovedOnTeam(teamId) || isTeamMember(teamId) || isLinkedParentTeamMember(teamId);
        allow write: if isHqTeam(teamId)
          && (isApprovedOnTeam(teamId) || isTeamMember(teamId) || isLinkedParentTeamMember(teamId));
      }

      match /attendance_rules/{ruleId} {
        allow read: if isApprovedOnTeam(teamId) || isTeamMember(teamId) || isLinkedParentTeamMember(teamId);
        allow write: if isHqTeam(teamId) && isOwnerOrManagerOnTeam(teamId);
      }
    }

    match /announcements/{announcementId} {
      // 任何通过审批的用户均可读取有效公告
      allow read: if hasUserDoc() && userDoc().role in ['owner', 'manager', 'recruiter'];
      // 发布权限：仅限 owner 或 manager
      allow create: if hasUserDoc() && userDoc().role in ['owner', 'manager'];
      // 修改权限：创建人或团队 owner/manager；或者更新 readCount / ackCount 计数
      allow update: if hasUserDoc() && (
        userDoc().role in ['owner', 'manager'] ||
        resource.data.author.id == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readCount', 'ackCount'])
      );
      allow delete: if hasUserDoc() && (userDoc().role in ['owner', 'manager'] || resource.data.author.id == request.auth.uid);
    }

    match /announcement_reads/{readId} {
      // 允许审批通过的团队成员读取已读列表
      allow read: if hasUserDoc() && userDoc().role in ['owner', 'manager', 'recruiter'];
      // 用户只能创建/更新属于自己的已读记录，文档 ID 必须为 announcementId_userId
      allow create, update: if hasUserDoc()
        && request.resource.data.userId == request.auth.uid
        && readId == request.resource.data.announcementId + '_' + request.auth.uid;
      allow delete: if hasUserDoc() && userDoc().role == 'owner';
    }
  }
}
