{
  "name": "talent-flow",
  "version": "2.1.0",
  "description": "TALENT FLOW - Cloud-native Internship Recruitment & Candidate Management Web App",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node --max-old-space-size=400 ./node_modules/next/dist/bin/next build",
    "start": "next start",
    "test:identity": "node --test lib/identity.test.mjs",
    "test:reminder": "node --test lib/interview-reminder.test.mjs",
    "test:job-order-sheet": "node --test lib/job-order-sheet.test.mjs",
    "test:order-view": "node --test lib/order-view.test.mjs",
    "test:commission": "node --test lib/commission-engine.test.mjs"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
