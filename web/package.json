    "chart.js": "^4.5.0",
    "docx": "^9.7.1",
    "file-saver": "^2.0.5",
    "firebase": "^11.9.0",
    "html2pdf.js": "^0.14.0",
    "next": "16.4.2",
    "pdfjs-dist": "^6.3.289",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-indiana-drag-scroll": "^2.2.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-next": "16.4.2"
  }
